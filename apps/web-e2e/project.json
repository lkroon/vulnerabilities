{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "implicitDependencies": ["web"],
  "targets": {
    "e2e": {
      "metadata": {
        "technologies": ["playwright"],
        "description": "Runs Playwright Tests",
        "help": {
          "command": "npx playwright test --help",
          "example": { "options": { "workers": 1 } }
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "^{projectRoot}/tsconfig*.json",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions", "extends", "files", "include"]
        },
        { "externalDependencies": ["@playwright/test"] }
      ],
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/web-e2e/test-output",
        "{workspaceRoot}/dist/.playwright/apps/web-e2e/playwright-report"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web-e2e",
        "command": "playwright test"
      },
      "configurations": {},
      "parallelism": true
    }
  }
}
